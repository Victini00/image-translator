output/*
!output/.gitkeep
legacy/EasyOCR(사용안함)/
external/*
!external/.gitkeep
data/*
!data/.gitkeep

# 데이터 파일은 올리지 않되, 원본 이미지를 어디에 두면 되는지 알 수 있도록
# 폴더 구조는 남긴다 (README/실행 예시가 이 경로를 가리킴)
!data/raw/
data/raw/*
!data/raw/images/
data/raw/images/*
!data/raw/images/.gitkeep

# 발표 자료 (v1만 올리고 나머지는 제외)
docs/Project PPT.pptx
docs/Project PDF.pdf

# ---------------------------------------------------------------- 모델 파일
# 기본은 전부 제외하되, "추론에 실제로 필요한 것"만 골라서 올린다.
# (학습 체크포인트/옵티마이저 상태/로그는 수백 MB라 GitHub에 부적합.
#  받는 방법은 README의 '모델 준비' 항목 참고)
models/*
!models/.gitkeep

# 파인튜닝한 일본어 인식 모델 - 추론용 파일과 학습 설정만 포함(버전당 약 17MB).
# v5(2차)가 파이프라인 기본값이고, v4(1차)는 성능 비교용으로 남겨 둔다.
!models/ocr/
models/ocr/*
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v4/
models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v4/*
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v4/complete_model/
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v4/config.yml
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v5/
models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v5/*
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v5/complete_model/
!models/ocr/PP-OCRv5_mobile_rec_jp_fine_tuned_v5/config.yml

# 나머지 모델은 파일을 올리지 않되, "어디에 무엇을 넣어야 하는지" 알 수 있도록
# 폴더 구조와 안내 README는 남긴다 (경로는 코드가 기대하는 위치와 동일)
!models/inpainting/
models/inpainting/*
!models/inpainting/LaMa/
models/inpainting/LaMa/*
!models/inpainting/LaMa/README.md

!models/translation/
models/translation/*
!models/translation/hell0ks_ja-ko-vn-7b-v1/
models/translation/hell0ks_ja-ko-vn-7b-v1/*
!models/translation/hell0ks_ja-ko-vn-7b-v1/lora/
models/translation/hell0ks_ja-ko-vn-7b-v1/lora/*
!models/translation/hell0ks_ja-ko-vn-7b-v1/lora/v1/
models/translation/hell0ks_ja-ko-vn-7b-v1/lora/v1/*
!models/translation/hell0ks_ja-ko-vn-7b-v1/lora/v1/README.md

# 개인 메모 (공개 리포에 안 올릴 것)
메모.txt

# API 키 등 비밀값 (.env.example만 커밋, 실제 값 담긴 .env는 제외)
.env

# 에디터 개인 설정
.vscode/

# Claude Code 설정 - 전부 제외.
# 이 PC의 절대경로와 개인 권한 허용 목록이라 다른 환경에서 쓸 수 없고,
# 로컬 디렉터리 구조가 그대로 드러난다.
.claude/

# OS/캐시
.DS_Store
__pycache__/
*.pyc
